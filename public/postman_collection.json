	"item": [
		{
			"name": "01 - Presensi & Kehadiran (API v1)",
			"description": "Endpoint RESTful API V1 untuk presensi kehadiran, clock in, clock out, shift, dan riwayat.",
			"item": [
				{
					"name": "Daftar Shift Kerja",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/attendance/shifts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"attendance",
								"shifts"
							]
						},
						"description": "Mengambil master data shift kerja aktif (pagi, siang, malam)."
					},
					"response": []
				},
				{
					"name": "Presensi Masuk (Clock In)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"employee_id\": {{employeeId}},\n    \"branch_id\": {{branchId}},\n    \"latitude\": {{latitude}},\n    \"longitude\": {{longitude}},\n    \"shift_id\": null,\n    \"is_mock_location\": false,\n    \"notes\": \"Presensi masuk via Postman API\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/attendance/clock-in",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"attendance",
								"clock-in"
							]
						},
						"description": "Melakukan clock-in dengan validasi geofence radius cabang dan deteksi mock GPS."
					},
					"response": []
				},
				{
					"name": "Presensi Pulang (Clock Out)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"employee_id\": {{employeeId}},\n    \"branch_id\": {{branchId}},\n    \"latitude\": {{latitude}},\n    \"longitude\": {{longitude}},\n    \"is_mock_location\": false,\n    \"notes\": \"Presensi pulang via Postman API\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/attendance/clock-out",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"attendance",
								"clock-out"
							]
						},
						"description": "Melakukan clock-out pada hari kerja aktif."
					},
					"response": []
				},
				{
					"name": "Status Presensi Hari Ini",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/attendance/today?employee_id={{employeeId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"attendance",
								"today"
							],
							"query": [
								{
									"key": "employee_id",
									"value": "{{employeeId}}",
									"description": "ID Karyawan"
								}
							]
						},
						"description": "Memeriksa apakah karyawan sudah clock-in / clock-out pada hari ini."
					},
					"response": []
				},
				{
					"name": "Riwayat Presensi Karyawan",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/attendance/history?employee_id={{employeeId}}&month=10&year=2026",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"attendance",
								"history"
							],
							"query": [
								{
									"key": "employee_id",
									"value": "{{employeeId}}",
									"description": "ID Karyawan"
								},
								{
									"key": "month",
									"value": "10",
									"description": "Bulan (opsional)"
								},
								{
									"key": "year",
									"value": "2026",
									"description": "Tahun (opsional)"
								}
							]
						},
						"description": "Mengambil log riwayat kehadiran karyawan dengan pagination."
					},
					"response": []
				}
			]
		},
		{
			"name": "02 - Cuti & Izin (API v1)",
			"description": "Endpoint RESTful API V1 untuk pengajuan dan riwayat cuti/izin karyawan.",
			"item": [
				{
					"name": "Pengajuan Cuti / Izin (Form URL Encoded / JSON)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"employee_id\": {{employeeId}},\n    \"leave_type\": \"annual\",\n    \"start_date\": \"2026-10-20\",\n    \"end_date\": \"2026-10-21\",\n    \"reason\": \"Keperluan keluarga\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/leave/request",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"leave",
								"request"
							]
						},
						"description": "Ajukan permohonan cuti (annual, sick, permission, emergency)."
					},
					"response": []
				},
				{
					"name": "Riwayat Pengajuan Cuti / Izin",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/leave/history?employee_id={{employeeId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"leave",
								"history"
							],
							"query": [
								{
									"key": "employee_id",
									"value": "{{employeeId}}",
									"description": "ID Karyawan"
								}
							]
						},
						"description": "Melihat riwayat status approval cuti atau izin karyawan."
					},
					"response": []
				}
			]
		},
